# Keep server-side files byte-exact: systemd units, EnvironmentFiles and shell
# scripts are read by Linux tooling and must not be rewritten to CRLF on checkout.
*             text eol=lf
*.sh          text eol=lf
*.service     text eol=lf
*.env         text eol=lf
*.env.example text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.example     text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
