# EnvironmentFile for hindsight-api.service  ->  ~/.hermes/hindsight-api.env (mode 600)
#
# Variable names and non-secret values are the ones actually used by this host's
# service. Every secret is replaced with <REDACTED>. Do not commit a filled-in copy.
#
# NOTE: this file is a systemd EnvironmentFile, i.e. `KEY=value` lines. It is NOT a
# shell script — do not put quotes, spaces around '=', or shell syntax in it.

# --- Offline model policy ---------------------------------------------------
# Embeddings and reranker are downloaded once and then run from the local cache.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Embeddings (local) -----------------------------------------------------
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Reranker (local) -------------------------------------------------------
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=Qwen/Qwen3-Reranker-0.6B

# --- LLM used by reflect / consolidation ------------------------------------
# Any OpenAI-compatible endpoint works. Here it is a local inference server.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:11370/v1
HINDSIGHT_API_LLM_MODEL=qwen3.8-flash-next-iq3_xxs
HINDSIGHT_API_LLM_API_KEY=<REDACTED>
# Long generations: a reflect over a large bank can take minutes.
HINDSIGHT_API_LLM_TIMEOUT=300
HINDSIGHT_API_REFLECT_LLM_TIMEOUT=300
# Passed through to the chat-completions body. Disables the thinking block for
# this particular served checkpoint. Drop it if your endpoint rejects unknown fields.
HINDSIGHT_API_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# --- Tenant / API-key authentication ----------------------------------------
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=<REDACTED>

# --- MCP default bank -------------------------------------------------------
# Bank used when an MCP request carries no bank_id at all. Without this line the
# server falls back to a bank literally named "default". See docs/banks.md.
HINDSIGHT_MCP_BANK_ID=sylw
